{
  "name": "kiasucode",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n frontend,backend -c cyan,magenta \"npm run dev --workspace @kiasucode/frontend\" \"npm run dev --workspace @kiasucode/backend\"",
    "dev:frontend": "npm run dev --workspace @kiasucode/frontend",
    "dev:backend": "npm run dev --workspace @kiasucode/backend",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test:e2e": "playwright test"
  },

  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "concurrently": "^9.2.5"
  },
  "engines": {
    "node": ">=22"
  }
}
